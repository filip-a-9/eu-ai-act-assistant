# Copy to .env and fill in. .env is gitignored; this file is not.

# Required. No default -- core/config.py raises if it is missing.
OPENAI_API_KEY=sk-...

# Optional. The values below are the defaults baked into core/config.py;
# uncomment only to override.
#EMBED_MODEL=text-embedding-3-small
#CHAT_MODEL=gpt-5.6-terra
#TOP_K=5
# How many candidates each retriever contributes before the dense and lexical
# rankings are fused. Larger than TOP_K on purpose: a chunk the vector store
# ranked 40th is only rescuable if BM25 reached deep enough to still see it.
#FUSION_CANDIDATES=50
# 1.0, not 0.0: gpt-5.6 returns a 400 for every temperature but its default.
# Answers are held to the law by the citation check, not by sampling.
#TEMPERATURE=1.0
# How many questions one Streamlit session may ask before the input locks.
# Each one calls a paid model, so this is the app's spend bound.
#MAX_QUESTIONS=10
# The same bound per client address, across sessions, so that reloading the
# page is not a way around the line above. Three sessions' worth, because an
# office or a mobile network reaches the app from one address.
#MAX_QUESTIONS_PER_IP=30
#RAW_DIR=data/raw
#CHUNKS_DIR=data/chunks
#INDEX_DIR=data/index
# Where the index is copied before it is opened. Chroma's client writes to the
# directory it opens, so the app never opens the committed index directly.
# Unset means the system temp directory; set this if the only writable mount
# on your host is somewhere else.
#SCRATCH_DIR=
#LOGS_DIR=data/logs

# Copy to .env and fill in. .env is gitignored; this file is not.

# Required. No default -- core/config.py raises if it is missing.
OPENAI_API_KEY=sk-...

# Optional. The values below are the defaults baked into core/config.py;
# uncomment only to override.
#EMBED_MODEL=text-embedding-3-small
#CHAT_MODEL=gpt-5.6-terra
#TOP_K=5
# 1.0, not 0.0: gpt-5.6 returns a 400 for every temperature but its default.
# Answers are held to the law by the citation check, not by sampling.
#TEMPERATURE=1.0
# How many questions one Streamlit session may ask before the input locks.
# Each one calls a paid model, so this is the app's spend bound.
#MAX_QUESTIONS=10
#RAW_DIR=data/raw
#CHUNKS_DIR=data/chunks
#INDEX_DIR=data/index
#LOGS_DIR=data/logs
